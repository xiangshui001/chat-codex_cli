{
  "base_branch": "main",
  "codex_command": ["codex"],
  "max_attempts": 2,
  "model_timeout_seconds": 1200,
  "max_changed_files": 15,
  "max_file_bytes": 524288,
  "protected_paths": ["AGENTS.md", "PROJECT.md", ".gitignore", ".codex/", "automation/", "schemas/", "docs/data-schema.md", "docs/decisions/", "data/raw/", "runtime/"],
  "roles": {
    "worker": {"model": null, "reasoning_effort": null},
    "reviewer": {"model": null, "reasoning_effort": null}
  },
  "checks": {
    "query_contract": {
      "argv": ["{python}", "{control}/automation/checks/query_contract.py"],
      "timeout_seconds": 60
    }
  }
}
